CXX = g++
BIN_NAME = solve_cpp

MACRO = -DFLAT -DNDEBUG

COPT = -std=c++17 $(MACRO) $(Wno) $(W) -g -Ofast
W = -Winline
Wno = -Wno-unused-result
LOPT = -lm

OBJDIR = obj_cpp

SRCS = $(wildcard *.cpp)
OBJS = $(patsubst %.cpp, $(OBJDIR)/%.o, $(SRCS))


$(BIN_NAME): $(OBJS)
	@echo  "\033[31m \nLinking all objects files: \033[0m"
	$(CXX) $^ $(LOPT) -o $(BIN_NAME)


$(OBJDIR)/%.o: %.cpp | $(OBJDIR)
	@echo  "\033[31m \nCompiling $<: \033[0m"
	$(CXX) -c $< -o $@ $(COPT)


	@echo  "\033[32m \ncreating $< dependency file: \033[0m"
	$(CXX) -MM $< > $(basename $@).d
	@mv -f $(basename $@).d $(basename $@).d.tmp
	@sed -e 's|.*:|$(basename $@).o:|' < $(basename $@).d.tmp > $(basename $@).d
	@rm -f $(basename $@).d.tmp

$(OBJDIR):
	@mkdir -p $(OBJDIR)

debug: MACRO = -DFLAT
debug: $(BIN_NAME)

flat: MACRO = -DFLAT -DNDEBUG
flat: $(BIN_NAME)

matrix: MACRO = -DMATRIX -DNDEBUG
matrix: $(BIN_NAME)

rand: MACRO = -DMATRIX -DRANDOM
rand: $(BIN_NAME)

clean:
	@echo "\033[31mcleaning obj directory \033[0m"
	@rm -f $(OBJDIR)/* $(BIN_NAME)

rebuild: clean $(BIN_NAME)

run: $(BIN_NAME)
	@./$(BIN_NAME)
