+#define T_S(i) solut.s[(size_t)((i)-1)]
+#define T_SEQ(j,i) solut.seq[(size_t)((i)-1)*(size_t)(data.dimen+1)+(size_t)((j)-1)]
+#define T_COST(a,b) data.cost(a, b)
+bool search_swap_tr(tSolution & solut, const tData & data) {
+    int i;
+    int j;
+    int i_prev;
+    int i_next;
+    int j_prev;
+    int j_next;
+
+    int I_best = 0;
+    int J_best = 0;
+
+    double cost_best;
+    double cost_new;
+    double cost_concat_1;
+    double cost_concat_2;
+    double cost_concat_3;
+    double cost_concat_4;
+
+
+    cost_best = DBL_MAX;
+    cost_new = double(0.0);
+    cost_concat_1 = double(0.0);
+    cost_concat_2 = double(0.0);
+    cost_concat_3 = double(0.0);
+    cost_concat_4 = double(0.0);
+
+    for (i = 2; i <= data.dimen - 1; i++) {
+        i_prev = i - 1;
+        i_next = i + 1;
+
+        cost_concat_1 =                 T_SEQ(i_prev, 1).T + T_COST(T_S(i_prev), T_S(i_next));
+        cost_concat_2 = cost_concat_1 + T_SEQ(i_next, i).T + T_COST(T_S(i), T_S(i_next + 1));
+
+        cost_new = T_SEQ(i_prev, 1).C                                                                             +
+                T_SEQ(i_next, i).W                * (cost_concat_1) + T_COST(T_S(i_next), T_S(i)) +
+                T_SEQ(data.dimen + 1, i_next + 1).W * (cost_concat_2) + T_SEQ(data.dimen + 1, i_next + 1).C;
+
+        if (cost_new < cost_best) {
+            cost_best = cost_new - std::numeric_limits<double>::epsilon();
+            I_best = i;
+            J_best = i_next;
+        }
+
+        for (j = i_next + 1; j <= data.dimen; j++) {
+
+            j_prev = j - 1;
+            j_next = j + 1;
+
+            cost_concat_1 =                 T_SEQ(i_prev, 1).T      + T_COST(T_S(i_prev), T_S(j));
+            cost_concat_2 = cost_concat_1                                  + T_COST(T_S(j), T_S(i_next));
+            cost_concat_3 = cost_concat_2 + T_SEQ(j_prev, i_next).T + T_COST(T_S(j_prev), T_S(i));
+            cost_concat_4 = cost_concat_3                                  + T_COST(T_S(i), T_S(j_next));
+
+            cost_new = T_SEQ(i_prev, 1).C                                                                    +   // 1st subseq
+                    cost_concat_1 +                                                                                     // concat 2nd subseq (single node)
+                    T_SEQ(j_prev, i_next).W       * cost_concat_2 + T_SEQ(j_prev, i_next).C           +   // concat 3rd subseq
+                    cost_concat_3 +                                                                                     // concat 4th subseq (single node)
+                    T_SEQ(data.dimen + 1, j_next).W * cost_concat_4 + T_SEQ(data.dimen + 1, j_next).C;    // concat 5th subseq
+
+            if (cost_new < cost_best) {
+                cost_best = cost_new - std::numeric_limits<double>::epsilon();
+                I_best = i;
+                J_best = j;
+            }
+
+        }
+
+    }
+
+    if (cost_best < solut.cost - std::numeric_limits<double>::epsilon()) {
+        swap(solut.s, I_best-1, J_best-1);
+        update_subseq_info_matrix(solut, data, I_best-1);
+        return true;
+    }
+    return false;
+}
