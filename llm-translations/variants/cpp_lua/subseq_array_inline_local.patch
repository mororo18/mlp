+-- FFI array for seq on LuaJIT, plain table on lua (our new_numeric_array)
+local ffi_ok, ffi = pcall(require, "ffi")
+local function new_numeric_array(n)
+    if ffi_ok then
+        return ffi.new("double[?]", n + 1)
+    else
+        local t = {}
+        for i = 1, n do
+            t[i] = 0.0
+        end
+        return t
+    end
