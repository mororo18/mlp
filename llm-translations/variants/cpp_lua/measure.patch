+
+-- measure.patch: monotonic wall clock through the FFI under LuaJIT (as our
+-- Lua does); os.clock() under plain Lua, which has no wall clock.
+local ffi_ok, ffi = pcall(require, "ffi")
+local wall_clock = os.clock
+if ffi_ok then
+    ffi.cdef[[
+        typedef struct { long tv_sec; long tv_nsec; } mlp_timespec;
+        int clock_gettime(int clk_id, mlp_timespec *tp);
+    ]]
+    local ts = ffi.new("mlp_timespec")
+    wall_clock = function()
+        ffi.C.clock_gettime(1, ts)
+        return tonumber(ts.tv_sec) + tonumber(ts.tv_nsec) * 1e-9
+    end
 end
 
