+// Vec indexed without bounds checks, as the get_unchecked of our Rust
+#[derive(Clone)]
+struct UVec<T>(Vec<T>);
+
+impl<T> std::ops::Index<usize> for UVec<T> {
+    type Output = T;
+    #[inline]
+    fn index(&self, i: usize) -> &T {
+        unsafe { self.0.get_unchecked(i) }
+    }
+}
+
+impl<T> std::ops::IndexMut<usize> for UVec<T> {
+    #[inline]
+    fn index_mut(&mut self, i: usize) -> &mut T {
+        unsafe { self.0.get_unchecked_mut(i) }
+    }
+}
+
+impl<T> std::ops::Deref for UVec<T> {
+    type Target = Vec<T>;
+    fn deref(&self) -> &Vec<T> {
+        &self.0
+    }
+}
+
+impl<T> std::ops::DerefMut for UVec<T> {
+    fn deref_mut(&mut self) -> &mut Vec<T> {
+        &mut self.0
+    }
+}
